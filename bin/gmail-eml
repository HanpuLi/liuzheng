#!/usr/bin/env python3
"""gmail-eml —— 把 Gmail 邮件导出成带 DKIM 的 .eml 原件

为什么需要它:
  Gmail 网页版对「已发送」邮件的「下载原始邮件」给的是你撰写的那份,
  DKIM / Authentication-Results / Received 全为空。DKIM 只存在于**收件方**副本里。
  MCP 的 read_email 给的是解析后的文本,也不是原件。
  本脚本走 Gmail API messages.get(format=raw),拿到的是真正的 RFC822 字节。

用法:
  gmail-eml --account default --query "in:sent newer_than:1d" --dest 目录
  gmail-eml --account work    --id 1a0527c5b7aed2af  --dest 目录 [--name 文件名.eml]
  gmail-eml --account default --id <ID> --check      # 只核验不落盘

  账号名对应 ~/.gmail-mcp/credentials-<账号名>.json;主账号用 default
  (即 ~/.gmail-mcp/credentials.json)。多账号是本工具的关键用法——
  DKIM 只在**收件方**副本里,所以要从「收到你那封信的那个账号」导出。

凭证: ~/.gmail-mcp/{credentials.json | credentials-<account>.json} + gcp-oauth.keys.json
      (Gmail MCP 服务器已经授权好的 OAuth token,直接复用)
"""
import json, base64, urllib.request, urllib.parse, os, sys, re, argparse, email
from email.header import decode_header, make_header

HOME = os.path.expanduser('~')
MCP  = f'{HOME}/.gmail-mcp'

def cred_path(account):
    p = f'{MCP}/credentials.json' if account == 'default' \
        else f'{MCP}/credentials-{account}.json'
    if not os.path.exists(p):
        sys.exit(f"找不到凭证: {p}\n现有: {[f for f in os.listdir(MCP) if f.startswith('credentials')]}")
    return p

def token(account):
    keys = json.load(open(f'{MCP}/gcp-oauth.keys.json'))['installed']
    c = json.load(open(cred_path(account)))
    data = urllib.parse.urlencode({
        'client_id': keys['client_id'], 'client_secret': keys['client_secret'],
        'refresh_token': c['refresh_token'], 'grant_type': 'refresh_token'}).encode()
    req = urllib.request.Request('https://oauth2.googleapis.com/token', data=data,
                                 headers={'Content-Type': 'application/x-www-form-urlencoded'})
    return json.load(urllib.request.urlopen(req))['access_token']

def api(tok, path):
    req = urllib.request.Request(f'https://gmail.googleapis.com/gmail/v1/users/me/{path}',
                                 headers={'Authorization': f'Bearer {tok}'})
    return json.load(urllib.request.urlopen(req))

def raw(tok, mid):
    return base64.urlsafe_b64decode(api(tok, f'messages/{mid}?format=raw')['raw'])

def decode_subject(v):
    if not v: return ''
    try: return str(make_header(decode_header(v)))[:60]
    except Exception: return v[:60]

def inspect(data):
    """核验证据力。⚠️ 必须解析完整头部——Gmail 把 ARC 头排在 DKIM-Signature 之前,
       只读前几 KB 会误判成「没有 DKIM」(2026-08-30 踩过)。"""
    m = email.message_from_bytes(data)
    ar = ' '.join(m.get_all('Authentication-Results') or [])
    return {
        'dkim_sig': 'DKIM-Signature' in m,
        'dkim':     'pass' if 'dkim=pass' in ar else ('fail' if 'dkim=' in ar else '—'),
        'spf':      'pass' if 'spf=pass' in ar else '—',
        'received': len(m.get_all('Received') or []),
        'attach':   sum(1 for p in m.walk() if p.get_filename()),
        'subject':  decode_subject(m.get('Subject')),
        'date':     m.get('Date', ''),
    }

def safe(s, n=48):
    s = re.sub(r'[/\\:\x00-\x1f]', '_', s or '')
    return re.sub(r'\s+', '_', s).strip('_')[:n]

ap = argparse.ArgumentParser()
ap.add_argument('--account', required=True, help='default | <账号名>(见 ~/.gmail-mcp/)')
ap.add_argument('--id', action='append', default=[], help='message id(可重复)')
ap.add_argument('--query', help='Gmail 搜索式,批量导出')
ap.add_argument('--dest', help='落盘目录')
ap.add_argument('--name', help='单封时指定文件名')
ap.add_argument('--prefix', default='', help='批量时的文件名前缀,如 我方发出_对方名_2026-08-30')
ap.add_argument('--max', type=int, default=50)
ap.add_argument('--check', action='store_true', help='只核验不落盘')
a = ap.parse_args()

tok = token(a.account)
ids = list(a.id)
if a.query:
    r = api(tok, 'messages?' + urllib.parse.urlencode({'q': a.query, 'maxResults': a.max}))
    ids += [m['id'] for m in r.get('messages', [])]
if not ids:
    sys.exit('没有匹配的邮件')

print(f"{'DKIM签名':8} {'dkim=':6} {'spf=':5} {'Rcvd':4} {'附件':4}  主题 / 落盘")
ok = 0
for mid in ids:
    data = raw(tok, mid)
    i = inspect(data)
    line = f"{'✓' if i['dkim_sig'] else '—':8} {i['dkim']:6} {i['spf']:5} {i['received']:<4} {i['attach'] or '':<4}  {i['subject']}"
    if a.check or not a.dest:
        print(line)
    else:
        os.makedirs(a.dest, exist_ok=True)
        fn = a.name if (a.name and len(ids) == 1) else \
             f"{a.prefix + '_' if a.prefix else ''}{safe(i['subject'])}_{mid[:8]}.eml"
        open(os.path.join(a.dest, fn), 'wb').write(data)
        print(line + f"\n{'':32}→ {fn}  ({len(data)} bytes)")
    ok += 1
print(f"\n共 {ok} 封。⚠️ 落盘后记得 stamp 对 manifest 盖戳(见 skills/luodang)。")
