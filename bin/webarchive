#!/bin/bash
# webarchive —— 把一份网页存档复制归入案卷并做证据锚定
#
# 用法:
#   webarchive <html文件> <案卷目录> [说明]
#   webarchive --latest  <案卷目录> [说明]
#
# 做四件事:
#   1. 复制进 <案卷>/_证据/webarchive/，文件名包含 UTC 时间戳 + 内容哈希
#   2. 算 SHA-256
#   3. stamp 打 RFC3161 + OTS
#   4. 追加一行到 <案卷>/_证据/anchors.jsonl（append-only 账本）
set -uo pipefail

SRC="${1:-}"; CASE="${2:-}"; NOTE="${3:-}"
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
STAMP_BIN="${LIUZHENG_STAMP_BIN:-$SCRIPT_DIR/stamp}"
if [ "$SRC" = "--latest" ]; then
  SRC=$(find "$HOME/Downloads" -maxdepth 1 -name "*.html" -newermt "-120 seconds" 2>/dev/null         | xargs -I{} stat -f "%m %N" {} 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)
  if [ -z "$SRC" ]; then
    echo "❌ ~/Downloads 里没有 120 秒内的新 .html"
    echo "   → 请确认存档落盘后改用显式路径"
    exit 1
  fi
  echo "📥 取最新: $(basename "$SRC")"
fi
[ -f "$SRC" ] || { echo "用法: webarchive <html文件|--latest> <案卷目录> [说明]"; exit 1; }
[ -d "$CASE" ] || { echo "❌ 案卷目录不存在: $CASE"; exit 1; }
[ -x "$STAMP_BIN" ] || { echo "❌ stamp 不可执行: $STAMP_BIN"; exit 1; }

DST="$CASE/_证据/webarchive"; mkdir -p "$DST"
TS="${LIUZHENG_NOW_UTC:-$(date -u '+%Y%m%dT%H%M%SZ')}"
BASE=$(basename "$SRC")
SRC_SHA=$(shasum -a 256 "$SRC" | cut -d' ' -f1)
SHORT="${SRC_SHA:0:12}"
OUT="$DST/${TS}__${SHORT}__${BASE}"
[ ! -e "$OUT" ] || { echo "❌ 拒绝覆盖已有证据文件: $OUT"; exit 1; }
cp -p "$SRC" "$OUT"

SHA=$(shasum -a 256 "$OUT" | cut -d' ' -f1)
[ "$SHA" = "$SRC_SHA" ] || { echo "❌ 复制后哈希不一致"; rm -f "$OUT"; exit 1; }

URL=$(sed -n 's/^url: //p' "$OUT" | head -1)
OBS=$(sed -n 's/^observedAt(UTC): //p' "$OUT" | head -1)
if [ -z "$URL" ]; then
  URL=$(head -c 2000 "$OUT" | tr '\r' '\n' | sed -n 's/^[[:space:]]*url:[[:space:]]*//p' | head -1 | sed 's/[[:space:]]*$//')
fi
if [ -z "$OBS" ]; then
  OBS=$(head -c 2000 "$OUT" | tr '\r' '\n' | sed -n 's/^[[:space:]]*saved date:[[:space:]]*//p' | head -1 | sed 's/[[:space:]]*$//')
fi
TOOL=$(head -c 2000 "$OUT" | grep -q "Page saved with SingleFile" && echo "SingleFile" || echo "MCP-DOM-export")

echo "📄 $(basename "$OUT")"
echo "   sha256 $SHA"
echo "   工具   $TOOL"
[ -n "$URL" ] && echo "   url    $URL"
[ -n "$OBS" ] && echo "   观察于 $OBS"

echo "🔏 打时间戳…"
"$STAMP_BIN" "$OUT" || echo "   ⚠️ 时间戳未达要求，请复查网络"

LEDGER="$CASE/_证据/anchors.jsonl"
python3 - "$LEDGER" "$SHA" "$(basename "$OUT")" "$URL" "$OBS" "$NOTE" "$CASE" "$TOOL" <<'PY'
import json,sys,subprocess,os
ledger,sha,fname,url,obs,note,case,tool = sys.argv[1:9]
try:
    head = subprocess.check_output(['git','-C',case,'rev-parse','HEAD'],
                                   stderr=subprocess.DEVNULL).decode().strip()
except Exception:
    head = None
rec = {"type":"webarchive","file":fname,"sha256":sha,"url":url or None,
       "observed_at":obs or None,"tool":tool,"note":note or None,"git_head":head,
       "recorded_at":subprocess.check_output(['date','-u','+%Y-%m-%dT%H:%M:%SZ']).decode().strip()}
os.makedirs(os.path.dirname(ledger), exist_ok=True)
with open(ledger,'a',encoding='utf-8') as f:
    f.write(json.dumps(rec,ensure_ascii=False,sort_keys=True)+'\n')
print(f"📒 已记入账本: {os.path.basename(ledger)}")
PY
echo "✅ 完成"
